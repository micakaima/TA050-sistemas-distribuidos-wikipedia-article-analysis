#!/usr/bin/env bash
set -e

MODULE="TA050-sistemas-distribuidos-wikipedia-article-analysis"

# Función de formateo: prefiere goimports (con -local), fallback a gofmt
format_files() {
    local files="$@"
    if command -v goimports >/dev/null 2>&1; then
        goimports -local "$MODULE" -w $files
    elif [ -x "$HOME/go/bin/goimports" ]; then
        "$HOME/go/bin/goimports" -local "$MODULE" -w $files
    elif command -v gofmt >/dev/null 2>&1; then
        echo "[pre-commit] Nota: goimports no encontrado, usando gofmt de respaldo."
        gofmt -w $files
    else
        echo "[pre-commit] Error: no se encontró ni goimports ni gofmt." >&2
        exit 1
    fi
}

# Obtener archivos .go en staging (Added, Copied, Modified)
STAGED_GO_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep '\.go$' || true)

if [ -n "$STAGED_GO_FILES" ]; then
    echo "[pre-commit] Formateando y ordenando imports..."
    format_files $STAGED_GO_FILES
    git add $STAGED_GO_FILES
fi
